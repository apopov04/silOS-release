# silOS main config. Copy to .env (`cp .env.example .env`) and fill in.
# .env is git-ignored; never commit it.

# Token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Your Telegram username, without the @. The bot ignores everyone else.
TELEGRAM_ALLOWED_USERNAME=your_telegram_username

# Timezone for the core (routines fire in this time). Any tz database name,
# e.g. Europe/London, America/New_York, Asia/Tokyo.
TZ=UTC
